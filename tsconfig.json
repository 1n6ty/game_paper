{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "jsx": "react-jsx",
    "strict": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "sourceMap": true,

    "baseUrl": "src",
    "paths": {
      "@/app/features/*": ["app/features/*"],
      "@/app/shared-kernel/*": ["app/shared-kernel/*"],
      "@/app/shell/*": ["app/shell/*"],
      "@/app/themes/*": ["app/themes/*"],
      "@/app/widgets/*": ["app/widgets/*"],
      "@/app/di/*": ["app/di/*"],
      "@/prod/*": ["prod/*"],
      "@/locales/*": ["locales/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "**/node_modules/*", "dist"]
}
